{
  "name": "sapiens-segmentation-adapter",
  "displayName": "Sapiens Segmentation Adapter",
  "version": "0.0.10",
  "scope": "public",
  "description": "Sapiens segmentation adapter for Dataloop",
  "codebase": {
    "type": "git",
    "gitUrl": "https://github.com/dataloop-ai-apps/sapiens-adapter.git",
    "gitTag": "0.0.10"
  },
  "components": {
    "computeConfigs": [
      {
        "name": "gpu-inference",
        "runtime": {
          "podType": "gpu-t4",
          "concurrency": 1,
          "runnerImage": "gcr.io/viewo-g/piper/agent/runner/apps/sapiens-adapter:0.0.1",
          "autoscaler": {
            "type": "rabbitmq",
            "minReplicas": 0,
            "maxReplicas": 2,
            "queueLength": 8
          }
        }
      }
    ],
    "modules": [
      {
        "name": "sapiens-segmentation-adapter-module",
        "entryPoint": "adapters/segmentation/model_adapter.py",
        "className": "SapiensSegmentationAdapter",
        "computeConfig": "gpu-inference",
        "initInputs": [
          {
            "name": "model_entity",
            "type": "Model"
          }
        ],
        "functions": [
          {
            "name": "predict_items",
            "input": [
              {
                "type": "Item[]",
                "name": "items"
              }
            ],
            "output": [
              {
                "type": "Item[]",
                "name": "items"
              }
            ]
          }
        ]
      }
    ],
