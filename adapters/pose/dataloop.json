{
  "name": "sapiens-pose-adapter",
  "displayName": "Sapiens Pose Adapter",
  "version": "0.0.12",
  "scope": "public",
  "description": "Sapiens pose adapter for Dataloop",
  "codebase": {
    "type": "git",
    "gitUrl": "https://github.com/dataloop-ai-apps/sapiens-adapter.git",
    "gitTag": "0.0.12"
  },
  "components": {
    "computeConfigs": [
      {
        "name": "cpu-inference",
        "runtime": {
          "podType": "regular-m",
          "concurrency": 1,
          "runnerImage": "gcr.io/viewo-g/piper/agent/runner/apps/sapiens-adapter:0.0.1",
          "autoscaler": {
            "type": "rabbitmq",
            "minReplicas": 0,
            "maxReplicas": 2,
            "queueLength": 8
          }
        }
      }
    ],
    "modules": [
      {
        "name": "sapiens-pose-adapter-module",
        "entryPoint": "adapters/pose/model_adapter.py",
        "className": "SapiensPoseAdapter",
        "computeConfig": "cpu-inference",
        "initInputs": [
          {
            "name": "model_entity",
            "type": "Model"
          }
        ],
        "functions": [
          {
            "name": "predict_items",
            "input": [
              {
                "type": "Item[]",
                "name": "items"
              }
            ],
            "output": [
              {
                "type": "Item[]",
                "name": "items"
              }
            ]
          }
        ]
      }
    ],
    "models": [
      {
        "name": "sapiens-pose-adapter-model-0.3b",
        "moduleName": "sapiens-pose-adapter-module",
        "status": "pre-trained",
        "configuration": {
          "weights_filename": "sapiens_0.3b_goliath_best_goliath_AP_573_torchscript.pt2",
          "input_height": 1024,
          "input_width": 768,
          "batch_size": 1
        },
        "artifacts": [
          {
            "type": "link",
            "url": "https://huggingface.co/facebook/sapiens-pose-0.3b-torchscript/resolve/main/sapiens_0.3b_goliath_best_goliath_AP_573_torchscript.pt2"
          }
        ],
        "labels": [
            "nose",
            "left_eye",
            "right_eye",
            "left_ear",
            "right_ear",
            "left_shoulder",
            "right_shoulder",
            "left_elbow",
            "right_elbow",
            "left_wrist",
            "right_wrist",
            "left_hip",
            "right_hip",
            "left_knee",
            "right_knee",
            "left_ankle",
            "right_ankle"
        ]
      },
      {
        "name": "sapiens-pose-adapter-model-0.6b",
        "moduleName": "sapiens-pose-adapter-module",
        "status": "pre-trained",
        "configuration": {
          "weights_filename": "sapiens_0.6b_goliath_best_goliath_AP_609_torchscript.pt2",
          "input_height": 1024,
          "input_width": 768,
          "batch_size": 1
        },
        "artifacts": [
          {
            "type": "link",
            "url": "https://huggingface.co/facebook/sapiens-pose-0.6b-torchscript/resolve/main/sapiens_0.6b_goliath_best_goliath_AP_609_torchscript.pt2"
          }
        ],
        "labels": [
            "nose",
